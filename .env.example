# Copia este archivo como .env y configura los valores antes de desplegar.
# Genera una clave con: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=REEMPLAZAR_POR_UNA_CLAVE_ALEATORIA_LARGA
# Opcional: ruta absoluta a la base de datos
# ENFERMERIA_DATABASE=C:\datos\enfermeria.sqlite3
# Solo activar si la app se sirve exclusivamente mediante HTTPS:
HTTPS_ONLY=0
PORT=5000
